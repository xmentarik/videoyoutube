{
  "name": "videoyoutube",
  "version": "1.0.0",
  "private": true,
  "description": "مشروع مونتاج فيديوهات يوتيوب باستخدام Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render CoursFrancais01 out/cours-francais-01.mp4",
    "tcf:voices": "python3 scripts/generate_tcf_audio.py gemini",
    "tcf:audio": "python3 scripts/measure_tcf_audio.py",
    "tcf:build": "remotion render TcfA1Partie1 out/tcf-canada-a1-partie1.mp4",
    "thumbnail": "remotion still MiniatureCours01 out/miniature-cours-01.png",
    "tcf:thumbnail": "remotion still MiniatureTcfA1Partie1 out/miniature-tcf-a1-partie1.png",
    "tcf2:voices": "python3 scripts/generate_tcf_audio.py gemini --part=2",
    "tcf2:audio": "python3 scripts/measure_tcf_audio.py --part=2",
    "tcf2:build": "remotion render TcfA1Partie2 out/tcf-canada-a1-partie2.mp4",
    "tcf2:thumbnail": "remotion still MiniatureTcfA1Partie2 out/miniature-tcf-a1-partie2.png",
    "tcf3:voices": "python3 scripts/generate_tcf_audio.py gemini --part=3",
    "tcf3:audio": "python3 scripts/measure_tcf_audio.py --part=3",
    "tcf3:build": "remotion render TcfA1Partie3 out/tcf-canada-a1-partie3.mp4",
    "tcf3:thumbnail": "remotion still MiniatureTcfA1Partie3 out/miniature-tcf-a1-partie3.png",
    "upgrade": "remotion upgrade",
    "lint": "tsc"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@remotion/cli": "4.0.535",
    "@remotion/media-utils": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
